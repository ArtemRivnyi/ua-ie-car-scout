{
  "name": "ua-ie-car-scout",
  "version": "0.1.0",
  "description": "Ukraine → Ireland car price comparator with import calculator",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "server": "node server/index.js",
    "dev:all": "node node_modules/concurrently/dist/bin/concurrently.js \"npm run dev\" \"npm run server\"",
    "test": "node --test test/scrapers.test.js",
    "test:api": "node --test tests/api.test.js tests/api_integration.test.js tests/dedup.test.js tests/importCalcService.test.js tests/priceService.test.js tests/parsers.test.js",
    "test:ui": "vitest run",
    "test:all": "npm run test:api && npm run test:ui && npm run test",
    "test:coverage": "c8 npm run test:all"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "i18next": "^23.7.0",
    "jimp": "^0.22.10",
    "lucide-react": "^0.383.0",
    "node-cache": "^5.1.2",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "c8": "^11.0.0",
    "concurrently": "^8.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.8"
  }
}
