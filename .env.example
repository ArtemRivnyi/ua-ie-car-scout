# ─────────────────────────────────────────────────────────────
#  UA → IE Car Scout — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# AUTO.RIA API key — free registration at https://developers.auto.ria.com/
# Without this key the UA search returns no results.
VITE_AUTORIA_API_KEY=your_autoria_key_here

# Backend server port (local dev only — Render assigns $PORT automatically)
PORT=3001

# Backend API base URL
# Local:
VITE_API_BASE=http://localhost:3001/api
# Production (uncomment and set after first Render deploy):
# VITE_API_BASE=https://ua-ie-car-scout-api.onrender.com
